# Travorse — local development environment
# Copy to .env.local and fill in values:
#   cp .env.example .env.local
#
# Generate AUTH_SECRET: openssl rand -base64 32
#
# Keycloak redirect URI (adjust if NEXT_PUBLIC_BASE_PATH is set):
#   http://localhost:3000/api/auth/callback/oidc
#
# Production deploys typically use Helm (helm/values.yaml → container env).
# See docs/SPECIFICATION.md §4.3.

# --- Routing (optional) ---

# Context path when the app is not served from the site root (Next.js basePath).
# Must be set at `npm run build` time (NEXT_PUBLIC_* is inlined for the browser).
# Helm: application.basePath → NEXT_PUBLIC_BASE_PATH (same value as the image build).
# NEXT_PUBLIC_BASE_PATH=/storage

# Public URL of this app (Auth.js AUTH_URL). Must match OIDC redirect URIs.
# With a context path, include it: http://localhost:3000/storage
AUTH_URL=http://localhost:3000

# Trust Host header (often needed for local `npm run dev`).
AUTH_TRUST_HOST=true

# --- Auth.js (required for sign-in) ---

AUTH_SECRET=

# --- OIDC / Keycloak (required for sign-in) ---

# Issuer URL, e.g. https://keycloak.example.com/realms/canfar
OIDC_ISSUER=

OIDC_CLIENT_ID=

OIDC_CLIENT_SECRET=

# Default matches Helm application.auth.scope
OIDC_SCOPE=openid profile email offline_access

# Refresh access token this many ms before expiry (default 300000 = 5 minutes)
# OIDC_ACCESS_TOKEN_REFRESH_MARGIN_MS=300000

# Legacy alias for AUTH_URL (optional)
# NEXTAUTH_URL=http://localhost:3000

# --- IVOA Registry (required when VOSPACE_URI is set) ---

# Comma-separated Registry base URLs, tried in order
# REGISTRY_URLS=https://cadc-reg.ca/reg

# REGISTRY_CACHE_TTL_SECONDS=1800
# REGISTRY_CONNECTION_TIMEOUT_MS=3000
# REGISTRY_READ_TIMEOUT_MS=6000
# REGISTRY_MAX_RETRIES=1

# --- VOSpace (optional until browse/storage features are configured) ---

# vos:// prefix for this deployment; ivo:// resource ID is derived from it
# Example: vos://cadc.nrc.ca~arc  →  ivo://cadc.nrc.ca/arc
# VOSPACE_URI=vos://cadc.nrc.ca~arc

# Session navigation shortcuts (Home / Projects toolbar links)
# VOSPACE_USER_HOME_DIR=/home
# VOSPACE_PROJECTS_FOLDER_PATH=/projects
# GROUP_MANAGEMENT_URI=https://example.com/groups

# VOSpace feature flags (Helm: application.vospace.features.*)
# VOSPACE_FEATURE_PAGING=true
# VOSPACE_FEATURE_EXTERNAL_LINKS=false

# --- Branding (optional) ---
# BRANDING_LOGO_URL=https://cdn.example.org/logo.png
# DEPLOYMENT_LABEL=My Vault Storage
